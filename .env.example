# ================================================================
# ENVIRONMENT VARIABLE TEMPLATE
# Copy this file to .env and fill in real values. Never commit .env.
# ================================================================

# ================================================================
# DJANGO CORE
# ================================================================
# Required in both dev and prod — the app fails to start without it.
SECRET_KEY=change-me-generate-a-random-django-secret-key
# production.py reads this via env.bool; development.py hardcodes True regardless.
DEBUG=False

# ================================================================
# DATABASE (PostgreSQL)
# ================================================================
# Used by config/settings/development.py (all have working defaults for local dev):
DB_NAME=it_ticketing_dev
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432

# Used by config/settings/production.py instead of the DB_* vars above.
# Required in production — app fails to start without it.
DATABASE_URL=postgresql://username:password@host:port/database_name

# ================================================================
# ALLOWED HOSTS / CSRF (production only, comma-separated, no spaces)
# ================================================================
ALLOWED_HOSTS=your-app-name.onrender.com,www.yourdomain.com
CSRF_TRUSTED_ORIGINS=https://your-app-name.onrender.com,https://www.yourdomain.com

# ================================================================
# CLOUDINARY (production media storage)
# Required in production — app fails to start without these three.
# ================================================================
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ================================================================
# EMAIL (SMTP fallback + Brevo API)
# EMAIL_HOST_USER / EMAIL_HOST_PASSWORD required in production.
# In development, leaving EMAIL_HOST unset falls back to console backend.
# ================================================================
EMAIL_HOST=smtp-relay.brevo.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=noreply@example.com

# Brevo transactional email API key (primary sending path outside SMTP).
BREVO_API_KEY=

# ================================================================
# REDIS (cache backend everywhere; Channels layer in production)
# ================================================================
REDIS_URL=redis://localhost:6379

# ================================================================
# VAPID KEYS (Web Push notifications, django-webpush)
# Generate with generate_vapid.py.
# ================================================================
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_CLAIM_EMAIL=noreply@example.com

# ================================================================
# SECURITY SETTINGS (production — all have sane defaults if unset)
# ================================================================
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=True
SECURE_HSTS_PRELOAD=True
SECURE_SSL_REDIRECT=True
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True
SESSION_COOKIE_AGE=86400

# ================================================================
# EXTERNAL SLA TRIGGER (authorizes the HTTP-triggerable SLA processing endpoint)
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
# ================================================================
SLA_TRIGGER_SECRET=

# ================================================================
# OPTIONAL / EDGE-CASE OVERRIDES
# ================================================================
# Bootstrap superuser on deploy (apps/accounts/management/commands/ensure_superuser.py).
# Skipped entirely by start.sh if either is unset.
SUPERUSER_EMAIL=
SUPERUSER_PASSWORD=

# Path to the LibreOffice binary used for Office->PDF preview conversion
# (apps/documents_display). Defaults to soffice.exe (Windows) / soffice (other OS).
# LIBREOFFICE_BINARY_PATH=

# Path to the npm binary used by django-tailwind. Auto-detected via
# shutil.which('npm') if unset — only set this if npm isn't on PATH.
# NPM_BIN_PATH=C:\Program Files\nodejs\npm.cmd

# Which settings module to load. Defaults to config.settings.development
# in manage.py/wsgi.py.
# DJANGO_SETTINGS_MODULE=config.settings.production
