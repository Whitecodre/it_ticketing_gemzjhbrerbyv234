# ================================================================
# DJANGO CORE
# ================================================================
SECRET_KEY=###############
DEBUG=False  # Set to True only for development

# ================================================================
# DATABASE (PostgreSQL)
# ================================================================
# For local development:
DB_NAME=it_ticketing_dev
DB_USER=postgres
DB_PASSWORD=########
DB_HOST=###########
DB_PORT=##########

# NPM_BIN_PATH is auto-detected via shutil.which() in config/settings/base.py.
# Only set this if npm is installed somewhere not on PATH.
# NPM_BIN_PATH=C:\Program Files\nodejs\npm.cmd

# For Render production (use DATABASE_URL instead):
DATABASE_URL=postgresql://username:password@host:port/database_name

# ================================================================
# ALLOWED HOSTS (comma-separated, no spaces)
# ================================================================
ALLOWED_HOSTS=your-app-name.onrender.com,www.yourdomain.com

# ================================================================
# CSRF TRUSTED ORIGINS (comma-separated, no spaces)
# ================================================================
CSRF_TRUSTED_ORIGINS=https://your-app-name.onrender.com,https://www.yourdomain.com

# ================================================================
# CLOUDINARY CONFIG
# ================================================================
CLOUDINARY_CLOUD_NAME=#######
CLOUDINARY_API_KEY=#############
CLOUDINARY_API_SECRET=###################

# ================================================================
# EMAIL CONFIG (Brevo API - No IP Restriction)
# ================================================================
# For SMTP fallback (optional)
EMAIL_HOST=smtp-relay.brevo.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=b0e2a9001@smtp-brevo.com
EMAIL_HOST_PASSWORD=###########################
DEFAULT_FROM_EMAIL=#########@gmail.com

# Brevo API Key (Recommended - No IP restriction)
BREVO_API_KEY=##################################

# ================================================================
# REDIS (For WebSocket/Channels)
# ================================================================
# REDIS_URL=redis://localhost:6379  # Update for Render (use Redis Cloud or Render's Redis)

# ================================================================
# VAPID KEYS (Push Notifications)
# ================================================================
VAPID_PUBLIC_KEY=###############################
VAPID_PRIVATE_KEY=###############################
VAPID_CLAIM_EMAIL=##############@gmail.com

# ================================================================
# SECURITY SETTINGS
# ================================================================
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=True
SECURE_HSTS_PRELOAD=True
SECURE_SSL_REDIRECT=True
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True
SESSION_COOKIE_AGE=86400

# ================================================================
# EXTERNAL TRIGGER SECRET (For cron jobs)
# ================================================================
SLA_TRIGGER_SECRET=###################################